# Secrets cho Edge Functions.
# Dùng cho `supabase functions serve --env-file supabase/functions/.env`
# và `supabase secrets set --env-file supabase/functions/.env` khi deploy.
#
# KHÔNG commit file .env thật. SUPABASE_SERVICE_ROLE_KEY chỉ được tồn tại ở đây,
# tuyệt đối không đưa sang frontend / Netlify env.

# Domain Netlify chính thức, phân tách bằng dấu phẩy. CORS chỉ chấp nhận các domain này.
ALLOWED_ORIGINS=http://localhost:5173,https://snackhub.netlify.app

# Dùng để dựng returnUrl / cancelUrl cho PayOS.
PUBLIC_SITE_URL=http://localhost:5173

# PayOS — lấy trong PayOS Merchant Portal
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# SUPABASE_URL, SUPABASE_ANON_KEY và SUPABASE_SERVICE_ROLE_KEY được runtime
# tự cấp khi deploy, chỉ cần khai báo khi chạy `supabase functions serve` ở
# local. ANON_KEY được create-staff-account dùng để xác thực JWT của người
# gọi (callerClient) — KHÔNG bypass RLS như SERVICE_ROLE_KEY.
# SUPABASE_URL=https://awquwyqtcbgbdqkpehnp.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
